{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "Jarvis, a mini Siri for Windows that lives in a notch at the top of your screen.",
  "author": "Reyaan Bindlish",
  "license": "MIT",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist": "electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.reyaanbindlish.jarvis",
    "productName": "Jarvis",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "zip",
      "artifactName": "Jarvis-win.zip",
      "icon": "build/icon.png",
      "signExecutable": false
    }
  }
}
